{% extends "layouts/page.njk" %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block organisationHeading %}
  {{ appOrganisationHeading({
    orgOrUserName: orgOrUserName,
    changeOrganisationUrl: changeOrganisationUrl
  }) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
    <p class="govuk-body">You are signed in as {{ fullName }}.</p>
    {% if representing and representing.organisationName %}
      <p class="govuk-body">You are representing {{ representing.organisationName }} as an {{ representing.relationship }}.</p>
      <p class="govuk-body"><a href="{{ defraAccountUrl }}" class="govuk-link" target="_blank" rel="noopener noreferrer">Your Defra account (opens in new tab)</a></p>
    {% endif %}
  </div>
</div>
{% endblock %}
