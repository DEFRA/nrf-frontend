{% extends "layouts/page.njk" %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    {{ govukPanel({
      titleText: pageHeading,
      text: "NRL reference: " + requestToUse.nrlReference
    }) }}

    <h2 class="govuk-heading-m">What happens next</h2>
    <p class="govuk-body">You will be sent an email with a commitment certificate that you can send to your local planning authority to include in your planning application.</p>
    <p class="govuk-body">The commitment certificate will disapply the relevant environmental obligations through the planning application process.</p>

    <h2 class="govuk-heading-m">Get help with nature restoration levy</h2>
    <p class="govuk-body">If you need help with the nature restoration levy, contact XXXX and give the NRL reference number.</p>
    <p class="govuk-body">
      Email: xxxxx@defra.gov.uk<br>
      Telephone: 00000000000<br>
      Monday to Friday, 8:30am to 5pm, except bank holidays
    </p>
    <p class="govuk-body">Find out about call charges</p>

    <p class="govuk-body"><a href="#" class="govuk-link">What did you think of this service?</a></p>
    <p class="govuk-body">(takes 30 seconds)</p>
    <p class="govuk-body"><a href="/request-to-use/commitment-email" class="govuk-link">View the email content</a></p>
  </div>
</div>
{% endblock %}
