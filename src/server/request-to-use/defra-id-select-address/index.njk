{% extends "layouts/page.njk" %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% block pageTitle %}{% if validationErrors %}Error: {% endif %}{{ pageTitle }}{% endblock %}

{% block beforeContent %}
  {{ backLink({href: backLinkPath}) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

        <form method="post" novalidate>
          {% include "partials/csrf-token.njk" %}
            {% if validationErrors %}
            {{ govukErrorSummary({
                titleText: "There is a problem",
                errorList:  validationErrors.summary
            }) }}
            {% endif %}

            <span class="govuk-caption-xl">Register Defra account</span>
            <h1 class="govuk-heading-xl">{{ pageHeading }}</h1>

            <div class="govuk-inset-text">
                <p class="govuk-body">We found the following addresses for postcode <span class="govuk-!-font-weight-bold">CM15 8HU</span></p>
                <p class="govuk-body"><a href="#" class="govuk-link">Change postcode</a></p>
            </div>

            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-visually-hidden">{{ pageHeading }}</legend>

                {{ govukSelect({
                    name: "address",
                    label: {
                        text: pageHeading
                    },
                    errorMessage: validationErrors.messagesByFormField.address,
                    value: formSubmitData.address,
                    items: [
                        {
                            value: "-1",
                            text: "2 addresses found",
                            selected: true
                        },
                        {
                            value: "40, FRIARS AVENUE, SHENFIELD, BRENTWOOD, CM15 8HU",
                            text: "40, FRIARS AVENUE, SHENFIELD, BRENTWOOD, CM15 8HU"
                        },
                        {
                            value: "42, FRIARS AVENUE, SHENFIELD, BRENTWOOD, CM15 8HU",
                            text: "42, FRIARS AVENUE, SHENFIELD, BRENTWOOD, CM15 8HU"
                        }
                    ]
                }) }}
            </fieldset>

            <div class="govuk-button-group">
                {{ govukButton({
                    text: "Continue"
                }) }}
                <a class="govuk-link" href="#">My address is not in this list</a>
            </div>

        </form>
    </div>
</div>
{% endblock %}
