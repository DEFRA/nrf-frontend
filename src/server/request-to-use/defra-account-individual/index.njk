{% extends "layouts/page.njk" %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block beforeContent %}
  {{ backLink({href: backLinkPath}) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">

    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    <p class="govuk-body">You need a Defra account to request to use the nature restoration levy and to view your commitment certificate. A Defra account lets you register with a range of online services from Defra and related organisations. You sign in to it with GOV.UK One Login or Government Gateway.</p>

    {{ govukWarningText({
      text: "You should only create a Defra account as an individual if the account is for your personal use.",
      iconFallbackText: "Warning"
    }) }}

    <h2 class="govuk-heading-m">Before you start</h2>

    <p class="govuk-body">To create a Defra account you need to provide:</p>

    <ul class="govuk-list govuk-list--bullet">
      <li>email address, phone number and postal address</li>
      <li>One Login or Government Gateway user ID and password. If you do not have a One Login or Government Gateway account, you can create one in the next step.</li>
    </ul>

    <h2 class="govuk-heading-m">If you already have a Defra account</h2>

    <p class="govuk-body">Sign in with the One Login or Government Gateway details you used to create it. You do not need to create a new account.</p>

    <div class="govuk-button-group">
      {{ govukButton({
        text: "Continue",
        href: continuePath
      }) }}
    </div>

  </div>
</div>
{% endblock %}
