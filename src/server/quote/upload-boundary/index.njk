{% extends "layouts/page.njk" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% block pageTitle %}{% if uploadError or validationErrors %}Error: {% endif %}{{ pageTitle }}{% endblock %}

{% block head %}
  {# Include after super() so the dataLayer push happens after GTM's consent
     defaults (from google-tag-manager-head.njk) are queued — gtm.js processes
     the queue in insertion order, so consent applies to this event. #}
  {{ super() }}
  {% include "partials/gtm-upload-result.njk" %}
{% endblock %}

{% block beforeContent %}
  {{ backLink({href: backLinkPath}) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

        {% if validationErrors %}
        {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: validationErrors.summary
        }) }}
        {% elseif uploadError %}
        {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: [{
                text: uploadError,
                href: "#file"
            }]
        }) }}
        {% endif %}

        {% if uploadUrl %}
        <form action="{{ uploadUrl }}" method="post" enctype="multipart/form-data" novalidate>

            {{ govukFileUpload({
                name: "file",
                id: "file",
                label: {
                    text: pageHeading,
                    classes: "govuk-label--l",
                    isPageHeading: true
                },
                hint: {
                    text: boundaryUploadHint
                },
                errorMessage: validationErrors.messagesByFormField.file if validationErrors,
                attributes: {
                    accept: ".geojson,.json,.kml,.zip"
                }
            }) }}

            {{ govukDetails({
                summaryText: "My file is in a different format",
                html: "You'll need to re-export the shape from the tool used to create it originally. If you don't have access to the file types listed, you can draw on a map instead."
            }) }}

            {{ govukButton({
                text: "Continue"
            }) }}

        </form>
        {% else %}
        <h1 class="govuk-heading-l">{{ pageHeading }}</h1>
        <p class="govuk-body">Unable to start file upload. Please try again later.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
