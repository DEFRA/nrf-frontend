{% extends "layouts/page.njk" %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block head %}
  {# Include after super() so the dataLayer push happens after GTM's consent
     defaults (from google-tag-manager-head.njk) are queued — gtm.js processes
     the queue in insertion order, so consent applies to this event. #}
  {{ super() }}
  {% if analyticsEnabled and gtmId and areAnalyticsCookiesAccepted %}
    <script nonce="{{ nonce }}" data-testid="gtm-excluded-area">
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'rlb_intersection_areas',
        rlb_option: {{ rlbOption | dump | safe }},
        rlb_excluded_area: {{ rlbExcludedArea | dump | safe }},
        rlb_edp: {{ rlbEdp | dump | safe }},
        rlb_catchment: {{ rlbCatchment | dump | safe }}
          {% if rlbCatchment2 %}, rlb_catchment2: {{ rlbCatchment2 | dump | safe }} {% endif %}
      });
    </script>
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {{ backLink({href: backLinkPath}) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

        <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

        <p class="govuk-body">Please use the existing Habitat Regulations to meet your environmental obligations.</p>
        <p class="govuk-body">
            <a href="https://www.gov.uk/guidance/habitats-regulations-assessments-protecting-a-european-site" class="govuk-link" rel="noopener noreferrer" target="_blank">Find out about Habitat Regulations (opens in new tab)</a>
        </p>
    </div>
</div>
{% endblock %}
