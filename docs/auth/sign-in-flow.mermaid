sequenceDiagram
    participant Browser
    participant Ctrl as Auth Controller<br/>(auth/controller.js)
    participant Yar as Yar Session Cookie<br/>(session-cache.js)
    participant Cache as Session Cache<br/>(server.app.sessionCache)
    participant OIDC as OIDC Discovery<br/>(get-oidc-config.js)
    participant DefraID as Defra ID Provider<br/>(External OIDC)

    %% Login page
    Browser->>Ctrl: GET /login
    Ctrl-->>Browser: Render auth/login.njk

    %% Start OAuth (manual, bypasses Bell redirect)
    Browser->>Ctrl: GET /auth/sign-in
    Ctrl->>OIDC: Fetch discovery doc (wellKnownUrl)
    OIDC-->>Ctrl: authorization_endpoint, token_endpoint
    Ctrl->>Ctrl: Generate CSRF state (crypto)
    Ctrl->>Yar: set oauth_state
    Ctrl-->>Browser: 302 to authorization_endpoint<br/>?client_id&response_type=code&redirect_uri<br/>&scope(openid offline_access)&serviceId&state
    Browser->>DefraID: GET authorization_endpoint

    %% External authentication
    DefraID->>Browser: Show login form
    Browser->>DefraID: Enter credentials
    DefraID-->>Browser: 302 to redirect_uri?code=xxx&state=yyy

    %% Callback
    Browser->>Ctrl: GET /login/return?code&state
    Ctrl->>Yar: get oauth_state
    Ctrl->>Ctrl: Verify state matches (CSRF), then clear oauth_state
    Ctrl->>DefraID: POST token_endpoint<br/>grant_type=authorization_code<br/>(code, client_id, client_secret, redirect_uri)
    DefraID-->>Ctrl: { access_token, refresh_token, id_token, expires_in }
    Ctrl->>Ctrl: Decode id_token (@hapi/jwt) -> profile
    Ctrl->>Ctrl: createUserSession() -> { sessionId (uuid),<br/>profile, token, refreshToken, isAuthenticated }
    Ctrl->>Cache: set(sessionId, userSession)
    Ctrl->>Yar: set sessionId
    Ctrl->>Yar: get + clear redirectTo
    Ctrl-->>Browser: 302 to getSafeRedirect(redirectTo or start page)
