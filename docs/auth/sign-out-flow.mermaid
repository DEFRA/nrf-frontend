sequenceDiagram
    participant Browser
    participant Ctrl as Auth Controller<br/>(auth/controller.js)
    participant Yar as Yar Session Cookie
    participant Cache as Session Cache<br/>(server.app.sessionCache)

    %% User-initiated sign out (requires active session)
    Browser->>Ctrl: GET /auth/sign-out  (auth: defra-session)
    alt not authenticated
        Ctrl-->>Browser: 302 to start page
    else authenticated
        Ctrl->>Cache: drop(sessionId)
        Ctrl->>Yar: clear sessionId
        Ctrl-->>Browser: 302 to start page
    end

    Note over Browser,Cache: Alternative: Defra ID logout callback (auth: false)

    %% OIDC sign-out callback
    Browser->>Ctrl: GET /auth/sign-out-oidc?state
    Ctrl->>Ctrl: Parse + log base64 state (best-effort)
    Ctrl->>Yar: get sessionId (failsafe)
    opt sessionId present
        Ctrl->>Cache: drop(sessionId)
        Ctrl->>Yar: clear sessionId
    end
    Ctrl-->>Browser: 302 to start page
