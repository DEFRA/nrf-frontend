sequenceDiagram
    participant Browser
    participant Scheme as defra-session scheme<br/>(defra-identity.js)
    participant Yar as Yar Session Cookie
    participant Cache as Session Cache<br/>(server.app.sessionCache)
    participant DefraID as Defra ID Provider<br/>(token_endpoint)

    Note over Browser,DefraID: Runs on every request to an auth: 'defra-session' route

    Browser->>Scheme: Request protected route
    Scheme->>Yar: get sessionId
    alt no sessionId
        Scheme-->>Browser: unauthenticated (302 by route)
    end
    Scheme->>Cache: get(sessionId)
    alt session not in cache
        Scheme->>Cache: drop(sessionId)
        Scheme->>Yar: clear sessionId
        Scheme-->>Browser: unauthenticated
    end

    Scheme->>Scheme: isTokenValid(token)?<br/>decode + verifyTime (60s skew)
    alt token still valid
        Scheme-->>Browser: authenticated { credentials: userSession }
    else token expired
        alt defraId.refreshTokens disabled
            Scheme->>Cache: drop(sessionId)
            Scheme->>Yar: clear sessionId
            Scheme-->>Browser: unauthenticated
        else refresh enabled
            Scheme->>DefraID: POST token_endpoint<br/>grant_type=refresh_token (refresh-tokens.js)
            alt refresh ok
                DefraID-->>Scheme: { access_token, refresh_token }
                Scheme->>Cache: set(sessionId, updated userSession)
                Scheme-->>Browser: authenticated { credentials: userSession }
            else refresh fails
                DefraID-->>Scheme: error
                Scheme->>Cache: drop(sessionId)
                Scheme->>Yar: clear sessionId
                Scheme-->>Browser: unauthenticated
            end
        end
    end
